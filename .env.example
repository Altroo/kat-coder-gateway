# Server runtime
KAT_GATEWAY_INSTALL_DIR=/opt/kat-coder-gateway
KAT_GATEWAY_MODEL_DIR=/opt/kat-coder-models/KAT-Coder-V2.5-Dev-colibri-i4-gs64
KAT_GATEWAY_HOST=127.0.0.1
KAT_GATEWAY_PORT=18080
KAT_GATEWAY_MODEL_ID=kat-coder-v2.5-dev-colibri
KAT_GATEWAY_CONTEXT=32768
KAT_GATEWAY_MAX_OUTPUT=8192
KAT_GATEWAY_RAM_GB=32
KAT_GATEWAY_THREADS=8
KAT_GATEWAY_MAX_QUEUE=1
KAT_GATEWAY_KV_SLOTS=1
KAT_GATEWAY_API_KEY=

# Workstation client and SSH tunnel
KAT_GATEWAY_BASE_URL=http://127.0.0.1:18080/v1
KAT_GATEWAY_LOCAL_PORT=18080
KAT_GATEWAY_REMOTE_PORT=18080
KAT_GATEWAY_SSH_HOST=YOUR_SERVER_HOST
KAT_GATEWAY_SSH_USER=YOUR_SSH_USER
KAT_GATEWAY_SSH_KEY=/absolute/path/to/YOUR_PRIVATE_KEY

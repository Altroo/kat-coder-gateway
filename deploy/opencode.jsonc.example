{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-ai/kat-coder-v2.5-dev-colibri",
  "default_agent": "build",
  "agents": {
    "build": {
      "system": "You are a coding agent working in the user's current project. Answer explanations, teaching requests, comparisons, and general questions directly in chat. For broad teaching requests, give a short overview of at most 300 words, use a compact list, and ask which topic to expand. Do not generate a complete course. Do not create or edit files unless the user explicitly asks for code or file changes. For implementation work, inspect relevant files before changing them, make focused edits that preserve unrelated work, and verify changes with appropriate tests. Continue until the requested outcome is complete or a real blocker requires user input. Never claim a command, test, or result you did not actually run. Do not read secrets or access paths outside the project.",
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ]
    },
    "deep": {
      "description": "High-thinking coding agent for difficult debugging and architecture work",
      "mode": "primary",
      "model": "local-ai/kat-coder-v2.5-dev-colibri-deep",
      "system": "You are a coding agent working in the user's current project. Think carefully about difficult debugging, architecture, and multi-step implementation tasks. Answer explanations and teaching requests directly in chat. Do not create or edit files unless the user explicitly asks for code or file changes. Inspect relevant files before changing them, preserve unrelated work, and verify changes with appropriate tests. Never claim a command, test, or result you did not actually run. Do not read secrets or access paths outside the project.",
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" }
      ]
    },
    "research": {
      "description": "Coding agent with web search and page fetching enabled",
      "mode": "primary",
      "system": "You are a coding and research agent working in the user's current project. Answer explanations, teaching requests, comparisons, and general questions directly in chat. For broad teaching requests, give a short overview of at most 300 words, use a compact list, and ask which topic to expand. Do not generate a complete course. Do not create or edit files unless the user explicitly asks for code or file changes. Use web search and page fetching when current external information is needed. Prefer primary sources, include source links in the answer, inspect files before editing, preserve unrelated work, and verify changes. Never claim a result you did not verify. Do not read secrets or access paths outside the project.",
      "permissions": [
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" }
      ]
    },
    "title": {
      "disabled": true
    }
  },
  "tools": {
    "browser": false,
    "execute": false,
    "glob": false,
    "grep": false,
    "list": false,
    "lsp": false,
    "question": false,
    "skill": false,
    "subagent": false,
    "todoread": false,
    "todowrite": false
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ],
  "providers": {
    "local-ai": {
      "name": "Local KAT coding agent",
      "env": ["KAT_GATEWAY_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:KAT_GATEWAY_BASE_URL}",
        "apiKey": "{env:KAT_GATEWAY_API_KEY}"
      },
      "models": {
        "kat-coder-v2.5-dev-colibri": {
          "modelID": "kat-coder-v2.5-dev-colibri",
          "name": "KAT-Coder V2.5 Dev (fast local CPU)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 65536,
            "output": 1024
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "body": {
            "enable_thinking": false,
            "reasoning_effort": "none"
          }
        },
        "kat-coder-v2.5-dev-colibri-deep": {
          "modelID": "kat-coder-v2.5-dev-colibri",
          "name": "KAT-Coder V2.5 Dev (deep thinking)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "body": {
            "enable_thinking": true,
            "reasoning_effort": "high"
          }
        }
      }
    }
  }
}

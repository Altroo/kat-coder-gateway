{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-ai/kat-coder-v2.5-dev-colibri",
  "agents": {
    "title": {
      "disabled": true
    }
  },
  "tools": {
    "browser": false,
    "execute": false,
    "skill": false,
    "subagent": false,
    "webfetch": false,
    "websearch": false
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ],
  "providers": {
    "local-ai": {
      "name": "Local KAT coding agent",
      "env": ["KAT_GATEWAY_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:KAT_GATEWAY_BASE_URL}",
        "apiKey": "{env:KAT_GATEWAY_API_KEY}"
      },
      "models": {
        "kat-coder-v2.5-dev-colibri": {
          "modelID": "kat-coder-v2.5-dev-colibri",
          "name": "KAT-Coder V2.5 Dev (local CPU)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "body": {
            "enable_thinking": true,
            "reasoning_effort": "high"
          }
        }
      }
    }
  }
}
